# ========================================================
# RushClaw.AI Environment Variables Template
# ========================================================

# Option 1: Google AI Studio / Gemini (Recommended - Generous Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Option 2: OpenRouter (Alternative)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_DEFAULT_MODEL=openrouter/auto

# Optional: Web Search & Crawling with Firecrawl
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Optional: Telegram Mode Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_OWNER_ID=your_telegram_user_id_here
